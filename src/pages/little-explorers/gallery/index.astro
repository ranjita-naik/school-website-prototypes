---
import Layout from "../../../layouts/LittleExplorersLayout.astro";
import { Image } from "astro:assets";
import assemblyPrayer from "../../../assets/photos/shared/assembly-prayer-01.jpg";
import scienceExperiment from "../../../assets/photos/shared/science-experiment-01.jpg";
import computerLab from "../../../assets/photos/shared/computer-lab-01.jpg";
import playgroundGround from "../../../assets/photos/shared/playground-ground-01.jpg";
import schoolGarden from "../../../assets/photos/shared/school-garden-01.jpg";
import buildingTrees from "../../../assets/photos/shared/building-trees-01.jpg";
import classroomChildrenTn1 from "../../../assets/photos/shared/classroom-children-tn-01.jpg";

const photos = [
  { img: assemblyPrayer, alt: "Students gathered for morning assembly" },
  { img: scienceExperiment, alt: "A teacher and student conducting a science experiment" },
  { img: computerLab, alt: "Students working at computers in the computer laboratory" },
  { img: playgroundGround, alt: "A green sports field used for games" },
  { img: schoolGarden, alt: "The school garden tended by students" },
  { img: classroomChildrenTn1, alt: "Students at their desks in a classroom" },
  { img: buildingTrees, alt: "A school building seen through lush green trees" },
];
---

<Layout
  title="Gallery — Little Explorers — Green Valley Matriculation School"
  description="Photographs of campus life at Green Valley Matriculation School."
>
  <section class="page-hero">
    <p class="eyebrow">Gallery</p>
    <h1>A few stops from the map.</h1>
    <p class="hero-lede">
      Temporary photography, standing in for the school's own. Every image here will be
      replaced with real, permission-cleared photography before launch.
    </p>
  </section>

  <section class="content-wide">
    <ul class="gallery-grid">
      {photos.map((p) => (
        <li><Image src={p.img} alt={p.alt} width={640} height={480} /></li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .gallery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 5rem; }
  .gallery-grid :global(img) { border-radius: 20px; width: 100%; aspect-ratio: 4/3; object-fit: cover; }

  @media (max-width: 1024px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .gallery-grid { grid-template-columns: 1fr; }
  }
</style>
