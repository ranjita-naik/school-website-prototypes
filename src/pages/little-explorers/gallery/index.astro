---
import Layout from "../../../layouts/LittleExplorersLayout.astro";
import { Image } from "astro:assets";
import studentsPrimary from "../../../assets/photos/shared/students-primary-01.jpg";
import gardenPathway from "../../../assets/photos/shared/garden-pathway-01.jpg";
import classroomBright from "../../../assets/photos/shared/classroom-bright-01.jpg";
import schoolGarden from "../../../assets/photos/shared/school-garden-01.jpg";
import buildingTrees from "../../../assets/photos/shared/building-trees-01.jpg";
import libraryStacks from "../../../assets/photos/shared/library-stacks-01.jpg";

const photos = [
  { img: gardenPathway, alt: "A palm-lined garden path across the campus" },
  { img: studentsPrimary, alt: "A teacher with primary-school students in class" },
  { img: classroomBright, alt: "A bright classroom with colourful desks ready for the day" },
  { img: schoolGarden, alt: "The school garden path lined with flowering shrubs" },
  { img: libraryStacks, alt: "Bookshelves lining the school library" },
  { img: buildingTrees, alt: "The school building glimpsed through the surrounding trees" },
];
---

<Layout
  title="Gallery — Little Explorers — Green Valley Matriculation School"
  description="Photographs of campus life at Green Valley Matriculation School."
>
  <section class="page-hero">
    <p class="eyebrow">Gallery</p>
    <h1>A few stops from the map.</h1>
    <p class="hero-lede">
      Temporary photography, standing in for the school's own. Every image here will be
      replaced with real, permission-cleared photography before launch.
    </p>
  </section>

  <section class="content-wide">
    <ul class="gallery-grid">
      {photos.map((p) => (
        <li><Image src={p.img} alt={p.alt} width={640} height={480} /></li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .gallery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 5rem; }
  .gallery-grid :global(img) { border-radius: 20px; width: 100%; aspect-ratio: 4/3; object-fit: cover; height: auto; }

  @media (max-width: 1024px) {
    .gallery-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 720px) {
    .gallery-grid { grid-template-columns: 1fr; }
  }
</style>
