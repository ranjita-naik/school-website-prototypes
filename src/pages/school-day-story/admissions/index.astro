---
import Layout from "../../../layouts/SchoolDayStoryLayout.astro";

const steps = [
  { title: "Enquire", detail: "Share a few details about your child, by phone or email." },
  { title: "Visit", detail: "Walk the campus, meet teachers, and see a class in session." },
  { title: "Assess", detail: "A simple, age-appropriate conversation — not a stressful exam." },
  { title: "Join", detail: "Confirm your seat and begin the school year with us." },
];

const faqs = [
  { q: "What ages does Green Valley accept?", a: "Kindergarten begins at age 3. Older classes accept transfers where seats are available." },
  { q: "Is there an entrance exam?", a: "No. Admission is based on a short, age-appropriate conversation." },
  { q: "When does the academic year begin?", a: "Academic year and admission dates are placeholders pending confirmation from the school." },
];
---

<Layout
  title="Admissions — A School Day Story — Green Valley Matriculation School"
  description="How to enquire, visit, and join Green Valley Matriculation School."
>
  <section class="page-hero">
    <p class="eyebrow">3:30 PM · Where the Day Leads</p>
    <h1>If this feels right for your child.</h1>
    <p class="hero-lede">
      A short, calm process — here's exactly how it works.
    </p>
  </section>

  <section class="content-wide">
    <ol class="steps">
      {steps.map((item, i) => (
        <li class="step">
          <span class="step-num" aria-hidden="true">{i + 1}</span>
          <h3>{item.title}</h3>
          <p>{item.detail}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="content-section">
    <p class="eyebrow">Fees</p>
    <h2>A note on cost.</h2>
    <p>
      Fee details vary by class and are shared directly during your enquiry.
      <em>(Placeholder — actual fee structure to be confirmed with the school.)</em>
    </p>
  </section>

  <section class="content-section faq">
    <p class="eyebrow">Frequently Asked</p>
    <h2>A few common questions.</h2>
    <dl>
      {faqs.map((f) => (
        <>
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </>
      ))}
    </dl>
  </section>

  <section class="cta-band">
    <h2>Ready to talk it through?</h2>
    <p>Call or email the school office before you decide to visit.</p>
    <a class="btn btn-primary" href="/school-day-story/contact/">Contact the School</a>
  </section>
</Layout>

<style>
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .step { text-align: center; padding: 1.5rem 1rem; }
  .step-num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: 50%;
    background: var(--terracotta-600); color: #fff;
    font-family: "Lora", serif; font-weight: 600; margin-bottom: 0.75rem;
  }
  .step h3 { font-size: 1.05rem; margin-bottom: 0.25em; }
  .step p { font-size: 0.9rem; color: var(--ink-soft); margin: 0; }

  .faq dt { font-family: "Lora", serif; font-weight: 600; margin-top: 1.25em; }
  .faq dd { margin: 0.3em 0 0; color: var(--ink-soft); }

  @media (max-width: 1024px) {
    .steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .steps { grid-template-columns: 1fr; }
  }
</style>
