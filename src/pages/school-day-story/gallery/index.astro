---
import Layout from "../../../layouts/SchoolDayStoryLayout.astro";
import { Image } from "astro:assets";
import campusEntrance from "../../../assets/photos/shared/campus-entrance-01.jpg";
import campusPath from "../../../assets/photos/shared/campus-path-trees-01.jpg";
import assemblyMorning from "../../../assets/photos/shared/assembly-morning-01.jpg";
import eventPerformance from "../../../assets/photos/shared/event-performance-01.jpg";
import sportsGymnastics from "../../../assets/photos/shared/sports-gymnastics-01.jpg";
import schoolGarden from "../../../assets/photos/shared/school-garden-01.jpg";

const photos = [
  { img: campusPath, alt: "A tree-lined path leading through the school campus" },
  { img: campusEntrance, alt: "The school's entrance gate framed by trees" },
  { img: assemblyMorning, alt: "Students gathered in rows for morning assembly on the school ground" },
  { img: eventPerformance, alt: "Students singing together at a school celebration" },
  { img: schoolGarden, alt: "The school garden path lined with flowering shrubs" },
  { img: sportsGymnastics, alt: "Students performing a gymnastics display on sports day" },
];
---

<Layout
  title="Gallery — A School Day Story — Green Valley Matriculation School"
  description="Photographs from a day at Green Valley Matriculation School."
>
  <section class="page-hero">
    <p class="eyebrow">Gallery</p>
    <h1>Moments from the day.</h1>
    <p class="hero-lede">
      Temporary photography, standing in for the school's own. Every image here will be
      replaced with real, permission-cleared photography before launch.
    </p>
  </section>

  <section class="content-wide">
    <ul class="gallery-grid">
      {photos.map((p) => (
        <li><Image src={p.img} alt={p.alt} width={640} height={480} /></li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .gallery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 5rem; }
  .gallery-grid :global(img) { border-radius: 6px; width: 100%; aspect-ratio: 4/3; object-fit: cover; height: auto; }

  @media (max-width: 1024px) {
    .gallery-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 720px) {
    .gallery-grid { grid-template-columns: 1fr; }
  }
</style>
