---
import Layout from "../../../layouts/RootsAndHorizonsLayout.astro";
import { Image } from "astro:assets";
import teacherLecturing from "../../../assets/photos/shared/teacher-lecturing-01.jpg";

const leadership = [
  { name: "Mrs. Lakshmi Narayanan", role: "Principal" },
  { name: "Mr. Anand Kumar", role: "Vice Principal" },
  { name: "Mrs. Priya Selvam", role: "Head of Academics" },
  { name: "Mr. Joseph Ravi", role: "Head of Student Affairs" },
];
---

<Layout
  title="Faculty & Leadership — Roots and Horizons — Green Valley Matriculation School"
  description="Faculty and leadership at Green Valley Matriculation School."
>
  <section class="page-hero">
    <p class="eyebrow">Faculty &amp; Leadership</p>
    <h1>Chosen for character, not only qualification.</h1>
    <p class="hero-lede">All names below are placeholders, standing in for the school's real teaching staff.</p>
  </section>

  <section class="story-image">
    <Image src={teacherLecturing} alt="A teacher instructing students in a classroom" width={1600} height={700} />
  </section>

  <section class="content-section">
    <dl class="programme-list">
      {leadership.map((l) => (
        <div class="programme-row">
          <dt>{l.name}</dt>
          <dd>{l.role} <em>(placeholder name)</em></dd>
        </div>
      ))}
    </dl>
  </section>
</Layout>

<style>
  .story-image { max-width: 1100px; margin: 0 auto 4rem; padding: 0 1.5rem; }
  .story-image :global(img) { height: 300px; object-fit: cover; width: 100%; }

  .programme-list { margin-top: 1rem; border-top: 1px solid var(--line); }
  .programme-row { display: grid; grid-template-columns: 240px 1fr; gap: 2rem; padding: 1.4rem 0; border-bottom: 1px solid var(--line); }
  .programme-row dt { font-family: "Playfair Display", serif; font-weight: 700; }
  .programme-row dd { color: var(--ink-soft); margin: 0; }

  @media (max-width: 720px) {
    .programme-row { grid-template-columns: 1fr; gap: 0.4rem; }
  }
</style>
