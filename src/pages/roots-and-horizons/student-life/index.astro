---
import Layout from "../../../layouts/RootsAndHorizonsLayout.astro";
import { Image } from "astro:assets";
import playgroundGround from "../../../assets/photos/shared/playground-ground-01.jpg";

const activities = [
  "Football", "Volleyball", "Athletics", "Yoga", "Music", "Dance",
  "Art", "Science Club", "Literary Club", "Environmental Club", "Quiz Club", "Community Service",
];
---

<Layout
  title="Student Life — Roots and Horizons — Green Valley Matriculation School"
  description="Sport, clubs, and life beyond the classroom at Green Valley Matriculation School."
>
  <section class="page-hero">
    <p class="eyebrow">The Playground</p>
    <h1>Sport, clubs, and life beyond the classroom.</h1>
    <p class="hero-lede">
      Co-curricular life is treated as seriously as academics — a full sports field and twelve
      clubs to choose from.
    </p>
  </section>

  <section class="story-image">
    <Image src={playgroundGround} alt="A green sports field used for games and athletics" width={1600} height={700} />
  </section>

  <section class="content-section">
    <p class="eyebrow">Clubs &amp; Activities</p>
    <h2>Twelve ways to spend an afternoon.</h2>
    <ul class="fact-list two-col">
      {activities.map((a) => <li>{a}</li>)}
    </ul>
  </section>
</Layout>

<style>
  .story-image { max-width: 1100px; margin: 0 auto 4rem; padding: 0 1.5rem; }
  .story-image :global(img) { height: 320px; object-fit: cover; width: 100%; }

  .two-col { columns: 2; column-gap: 2rem; margin-top: 1.5rem; }
  .two-col li { break-inside: avoid; margin-bottom: 0.4em; }
  @media (max-width: 600px) {
    .two-col { columns: 1; }
  }
</style>
