---
import Layout from "../../../layouts/RootsAndHorizonsLayout.astro";
import { Image } from "astro:assets";
import libraryStacks from "../../../assets/photos/shared/library-stacks-01.jpg";
import campusGreen from "../../../assets/photos/shared/campus-green-01.jpg";
import schoolGarden from "../../../assets/photos/shared/school-garden-01.jpg";

const facilities = [
  "Bright, well-ventilated classrooms",
  "Science & computer laboratories",
  "Library and reading corners",
  "Sports field",
  "School garden",
  "School transport",
  "Safe drinking water",
  "Shaded walkways",
];
---

<Layout
  title="Campus & Facilities — Roots and Horizons — Green Valley Matriculation School"
  description="Classrooms, laboratories, library, and grounds at Green Valley Matriculation School."
>
  <section class="page-hero">
    <p class="eyebrow">The Walk Around Campus</p>
    <h1>Classrooms, laboratories, library, and grounds.</h1>
    <p class="hero-lede">A campus built with the same restraint as the rest of the school.</p>
  </section>

  <section class="content-section">
    <ul class="fact-list">
      {facilities.map((f) => <li>{f}</li>)}
    </ul>
  </section>

  <section class="content-wide mosaic">
    <figure><Image src={schoolGarden} alt="The school garden path lined with flowering shrubs" width={700} height={520} /></figure>
    <figure><Image src={libraryStacks} alt="Bookshelves lining the school library" width={700} height={520} /></figure>
    <figure><Image src={campusGreen} alt="A green lawn and walkway between the school buildings" width={700} height={520} /></figure>
  </section>
</Layout>

<style>
  .mosaic { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; background: var(--line); }
  .mosaic :global(img) { width: 100%; height: 260px; object-fit: cover; object-position: center 22%; }
  .mosaic figure { margin: 0; }

  @media (max-width: 720px) {
    .mosaic { grid-template-columns: 1fr; }
  }
</style>
