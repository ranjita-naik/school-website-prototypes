---
import Layout from "../../../layouts/RootsAndHorizonsLayout.astro";
import { Image } from "astro:assets";
import assemblyTrees from "../../../assets/photos/shared/assembly-02.jpg";
import campusGreen from "../../../assets/photos/shared/campus-green-01.jpg";
import studentsProject from "../../../assets/photos/shared/students-project-work-01.jpg";
import libraryStacks from "../../../assets/photos/shared/library-stacks-01.jpg";
import libraryReading from "../../../assets/photos/shared/library-reading-01.jpg";
import schoolGarden from "../../../assets/photos/shared/school-garden-01.jpg";

const photos = [
  { img: campusGreen, alt: "A green lawn and walkway between the school buildings" },
  { img: assemblyTrees, alt: "Students lined up for morning assembly under the campus trees" },
  { img: schoolGarden, alt: "The school garden path lined with flowering shrubs" },
  { img: studentsProject, alt: "Students working together on a project at their desks" },
  { img: libraryStacks, alt: "Bookshelves lining the school library" },
  { img: libraryReading, alt: "Students reading together at a table in the school library" },
];
---

<Layout
  title="Gallery — Roots and Horizons — Green Valley Matriculation School"
  description="Photographs of campus life at Green Valley Matriculation School."
>
  <section class="page-hero">
    <p class="eyebrow">Gallery</p>
    <h1>A record of the campus.</h1>
    <p class="hero-lede">
      Temporary photography, standing in for the school's own. Every image here will be
      replaced with real, permission-cleared photography before launch.
    </p>
  </section>

  <section class="content-wide">
    <ul class="gallery-grid">
      {photos.map((p) => (
        <li><Image src={p.img} alt={p.alt} width={640} height={480} /></li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .gallery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; background: var(--line); margin-bottom: 5rem; }
  .gallery-grid :global(img) { width: 100%; aspect-ratio: 4/3; object-fit: cover; height: auto; }

  @media (max-width: 1024px) {
    .gallery-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
