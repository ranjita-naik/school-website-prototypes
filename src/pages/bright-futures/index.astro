---
const base = import.meta.env.BASE_URL;
import Layout from "../../layouts/BrightFuturesLayout.astro";
import { Image } from "astro:assets";
import scienceExperiment from "../../assets/photos/shared/science-experiment-01.jpg";
import computerLab from "../../assets/photos/shared/computer-lab-01.jpg";
import teacherLecturing from "../../assets/photos/shared/teacher-lecturing-01.jpg";
import playgroundGround from "../../assets/photos/shared/playground-ground-01.jpg";
import assemblyPrayer from "../../assets/photos/shared/assembly-prayer-01.jpg";

const doorways = [
  { name: "About the School", desc: "Who we are, and what we stand for.", img: assemblyPrayer, alt: "Students in morning assembly outside the school building", href: base + "bright-futures/about/", accent: "coral" },
  { name: "Academics", desc: "Science, technology, arts, and sport — how it all fits together.", img: scienceExperiment, alt: "A teacher and student conducting a science experiment", href: base + "bright-futures/academics/", accent: "aqua" },
  { name: "Student Life", desc: "The field, the clubs, and everything after the bell.", img: playgroundGround, alt: "A green sports field used for games", href: base + "bright-futures/student-life/", accent: "sun" },
  { name: "Campus & Facilities", desc: "Labs, classrooms, and the spaces students learn in.", img: computerLab, alt: "The school's computer laboratory", href: base + "bright-futures/campus/", accent: "cobalt" },
  { name: "Admissions", desc: "How to enquire, visit, and apply.", img: assemblyPrayer, alt: "Students gathered together at the school", href: base + "bright-futures/admissions/", accent: "coral" },
];
---

<Layout
  title="Green Valley Matriculation School — Bright Futures"
  description="Green Valley Matriculation School, Nagercoil — a modern, future-ready school for Kindergarten through Class 10. Prototype concept: Bright Futures."
>
  <section class="hero" id="top">
    <div class="hero-copy">
      <p class="eyebrow">Nagercoil, Tamil Nadu · LKG – Class 10</p>
      <h1>Learn boldly. Think deeply. Grow confidently.</h1>
      <p class="hero-lede">
        Green Valley Matriculation School pairs strong academic structure with modern,
        hands-on learning — so every student is known well, supported, and a little more
        capable each year.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={base + "bright-futures/admissions/"}>Explore Admissions</a>
        <a class="btn btn-ghost" href="#doorways">See the School</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-frame">
        <Image src={teacherLecturing} alt="A teacher instructing students in a classroom" width={1100} height={1300} priority />
      </div>
    </div>
  </section>

  <section class="doorways" id="doorways">
    <div class="section-heading">
      <p class="eyebrow">Find Your Way In</p>
      <h2>One school, several places to start.</h2>
    </div>
    <ul class="doorway-grid">
      {doorways.map((d) => (
        <li class={`doorway-card accent-${d.accent} reveal`}>
          <a href={d.href}>
            <div class="doorway-image">
              <Image src={d.img} alt={d.alt} width={640} height={480} />
            </div>
            <span class="doorway-dot" aria-hidden="true"></span>
            <h3>{d.name}</h3>
            <p>{d.desc}</p>
            <span class="doorway-arrow" aria-hidden="true">Explore →</span>
          </a>
        </li>
      ))}
      <li class="doorway-card doorway-simple accent-aqua reveal">
        <a href={base + "bright-futures/contact/"}>
          <span class="doorway-dot" aria-hidden="true"></span>
          <h3>Contact</h3>
          <p>Reach the admissions desk, or find us on the map.</p>
          <span class="doorway-arrow" aria-hidden="true">Explore →</span>
        </a>
      </li>
    </ul>
  </section>

  <section class="cta-band reveal">
    <h2>Ready to see what your child could build here?</h2>
    <p>Campus tours run every working day. Admissions for the next academic year are open.</p>
    <a class="btn btn-primary btn-large" href={base + "bright-futures/contact/"}>Contact the Admissions Office</a>
  </section>
</Layout>

<style>
  .hero { max-width: 1280px; margin: 0 auto; padding: 3.5rem 1.5rem 3rem; display: grid; grid-template-columns: 1.05fr 1fr; gap: 3rem; align-items: center; }
  .hero h1 { font-size: clamp(2.2rem, 4.2vw, 3.2rem); }
  .hero-lede { max-width: 46ch; color: var(--ink-soft); font-size: 1.08rem; }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem; }

  .hero-visual { position: relative; }
  .hero-frame { border-radius: 32px; overflow: hidden; box-shadow: 0 30px 60px -20px rgba(16,24,43,0.3); transform: rotate(-1.2deg); }
  .hero-frame img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 1024px) {
    .hero { grid-template-columns: 1fr; }
    .hero-visual { order: -1; max-width: 420px; margin: 0 auto; }
  }
</style>
