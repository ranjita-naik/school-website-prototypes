---
import Layout from "../../../layouts/BrightFuturesLayout.astro";
import { Image } from "astro:assets";
import studentsDining from "../../../assets/photos/shared/students-dining-01.jpg";
import computerLab from "../../../assets/photos/shared/computer-lab-modern-01.jpg";

const pathways = [
  { name: "Science", desc: "Lab-based learning from Class 3 onward, with a working science club.", accent: "coral" },
  { name: "Technology", desc: "Computer literacy from Kindergarten; coding club from Class 6.", accent: "aqua" },
  { name: "Arts & Culture", desc: "Music, dance, and visual art woven into the weekly timetable.", accent: "sun" },
  { name: "Sports", desc: "Athletics, football, volleyball, and yoga on a full-size field.", accent: "cobalt" },
];

const stages = [
  { stage: "Kindergarten", classes: "Ages 3–5", detail: "Play-based foundations in language, number, and social skill." },
  { stage: "Primary", classes: "Classes 1–5", detail: "Core subjects taught with structured daily practice." },
  { stage: "Middle School", classes: "Classes 6–8", detail: "Widening subjects, growing independence." },
  { stage: "Secondary", classes: "Classes 9–10", detail: "Board-aligned preparation with close mentorship." },
];
---

<Layout
  title="Academics — Bright Futures — Green Valley Matriculation School"
  description="Academic pathways and class stages at Green Valley Matriculation School."
>
  <section class="page-hero">
    <p class="eyebrow">Academics</p>
    <h1>Four pathways, one confident foundation.</h1>
    <p class="hero-lede">
      Science, technology, arts, and sport — taught with equal seriousness, from Kindergarten
      through Class 10.
    </p>
  </section>

  <section class="doorways">
    <ul class="doorway-grid pathway-grid">
      {pathways.map((p) => (
        <li class={`doorway-card accent-${p.accent} reveal`}>
          <div class="pathway-inner">
            <span class="doorway-dot" aria-hidden="true"></span>
            <h3>{p.name}</h3>
            <p>{p.desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="content-wide">
    <div class="table-scroll">
      <table class="simple-table">
        <caption>Class stages</caption>
        <thead><tr><th>Stage</th><th>Classes</th><th>Focus</th></tr></thead>
        <tbody>
          {stages.map((s) => <tr><td>{s.stage}</td><td>{s.classes}</td><td>{s.detail}</td></tr>)}
        </tbody>
      </table>
    </div>
  </section>

  <section class="content-wide mosaic">
    <figure>
      <Image src={studentsDining} alt="Students sharing a meal during the lunch break" width={900} height={650} />
      <figcaption>Hands-on science, from Class 3</figcaption>
    </figure>
    <figure>
      <Image src={computerLab} alt="Rows of workstations in the school computer laboratory" width={900} height={650} />
      <figcaption>Computer lab, Classes 3–10</figcaption>
    </figure>
  </section>
</Layout>

<style>
  .pathway-grid { grid-template-columns: repeat(4, 1fr); }
  .pathway-grid .doorway-card { border-top: 4px solid transparent; }
  .accent-coral { border-top-color: var(--coral-500) !important; }
  .accent-aqua { border-top-color: var(--aqua-300) !important; }
  .accent-sun { border-top-color: var(--sun-400) !important; }
  .accent-cobalt { border-top-color: var(--cobalt-700) !important; }
  .pathway-inner { padding: 1.75rem 1.5rem; }
  .pathway-inner .doorway-dot { margin: 0 0 0.6em; }
  .pathway-inner h3 { margin-bottom: 0.35em; }
  .pathway-inner p { margin: 0; }

  .mosaic { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .mosaic img { border-radius: 20px; width: 100%; aspect-ratio: 4/3; object-fit: cover; height: auto; }
  .mosaic figcaption { font-size: 0.88rem; color: var(--ink-soft); margin-top: 0.6em; font-weight: 600; }

  @media (max-width: 1024px) {
    .pathway-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .mosaic { grid-template-columns: 1fr; }
    .pathway-grid { grid-template-columns: 1fr; }
  }
</style>
