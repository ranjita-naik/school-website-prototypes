---
import Layout from "../../../layouts/BrightFuturesLayout.astro";
import { Image } from "astro:assets";
import assemblyPrayer from "../../../assets/photos/shared/assembly-prayer-01.jpg";
import scienceExperiment from "../../../assets/photos/shared/science-experiment-01.jpg";
import computerLab from "../../../assets/photos/shared/computer-lab-01.jpg";
import playgroundGround from "../../../assets/photos/shared/playground-ground-01.jpg";
import teacherLecturing from "../../../assets/photos/shared/teacher-lecturing-01.jpg";
import classroomChildrenTn2 from "../../../assets/photos/shared/classroom-children-tn-02.jpg";
import campusEntrance from "../../../assets/photos/shared/campus-entrance-01.jpg";
import scienceLab from "../../../assets/photos/shared/science-lab-01.jpg";
import classroomInterior from "../../../assets/photos/shared/classroom-interior-01.jpg";

const photos = [
  { img: scienceExperiment, alt: "A teacher and student conducting a science experiment" },
  { img: assemblyPrayer, alt: "Students in morning assembly outside the school building" },
  { img: computerLab, alt: "Students working at computers in the computer laboratory" },
  { img: playgroundGround, alt: "A green sports field used for games" },
  { img: teacherLecturing, alt: "A teacher instructing students in a classroom" },
  { img: classroomChildrenTn2, alt: "Students reading and writing at their desks" },
  { img: campusEntrance, alt: "Tree-lined school entrance gate" },
  { img: scienceLab, alt: "School science and laboratory block" },
  { img: classroomInterior, alt: "Open-corridor classroom block" },
];
---

<Layout
  title="Gallery — Bright Futures — Green Valley Matriculation School"
  description="Photographs of campus life at Green Valley Matriculation School."
>
  <section class="page-hero">
    <p class="eyebrow">Gallery</p>
    <h1>A look inside Green Valley.</h1>
    <p class="hero-lede">
      Temporary photography, standing in for the school's own. Every image here will be
      replaced with real, permission-cleared photography before launch.
    </p>
  </section>

  <section class="content-wide">
    <ul class="gallery-grid">
      {photos.map((p) => (
        <li><Image src={p.img} alt={p.alt} width={640} height={480} /></li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .gallery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 5rem; }
  .gallery-grid :global(img) { border-radius: 16px; width: 100%; aspect-ratio: 4/3; object-fit: cover; }

  @media (max-width: 1024px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .gallery-grid { grid-template-columns: 1fr; }
  }
</style>
