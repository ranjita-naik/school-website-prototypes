---
import Layout from "../../../layouts/BrightFuturesLayout.astro";
import { Image } from "astro:assets";
import assemblyMorning from "../../../assets/photos/shared/assembly-morning-01.jpg";
import computerLab from "../../../assets/photos/shared/computer-lab-modern-01.jpg";
import libraryStudy from "../../../assets/photos/shared/library-study-01.jpg";
import studentsDining from "../../../assets/photos/shared/students-dining-01.jpg";
import campusBuilding from "../../../assets/photos/shared/campus-building-modern-01.jpg";
import classroomBright from "../../../assets/photos/shared/classroom-bright-01.jpg";

const photos = [
  { img: studentsDining, alt: "Students sharing a meal during the lunch break" },
  { img: assemblyMorning, alt: "Students gathered in rows for morning assembly on the school ground" },
  { img: computerLab, alt: "Rows of workstations in the school computer laboratory" },
  { img: campusBuilding, alt: "The school building seen across its front lawn" },
  { img: libraryStudy, alt: "Students studying at long desks in the school library" },
  { img: classroomBright, alt: "A bright classroom with colourful desks ready for the day" },
];
---

<Layout
  title="Gallery — Bright Futures — Green Valley Matriculation School"
  description="Photographs of campus life at Green Valley Matriculation School."
>
  <section class="page-hero">
    <p class="eyebrow">Gallery</p>
    <h1>A look inside Green Valley.</h1>
    <p class="hero-lede">
      Temporary photography, standing in for the school's own. Every image here will be
      replaced with real, permission-cleared photography before launch.
    </p>
  </section>

  <section class="content-wide">
    <ul class="gallery-grid">
      {photos.map((p) => (
        <li><Image src={p.img} alt={p.alt} width={640} height={480} /></li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .gallery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 5rem; }
  .gallery-grid :global(img) { border-radius: 16px; width: 100%; aspect-ratio: 4/3; object-fit: cover; height: auto; }

  @media (max-width: 1024px) {
    .gallery-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 720px) {
    .gallery-grid { grid-template-columns: 1fr; }
  }
</style>
