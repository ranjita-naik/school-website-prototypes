---
import Layout from "../../../layouts/BrightFuturesLayout.astro";
import { Image } from "astro:assets";
import computerLab from "../../../assets/photos/shared/computer-lab-modern-01.jpg";
import classroomBright from "../../../assets/photos/shared/classroom-bright-01.jpg";
import libraryStudy from "../../../assets/photos/shared/library-study-01.jpg";
import campusBuilding from "../../../assets/photos/shared/campus-building-modern-01.jpg";

const facilities = [
  "Bright, well-ventilated classrooms",
  "Science & computer laboratories",
  "Library and reading corners",
  "Activity rooms for art and music",
  "Sports field",
  "School garden",
  "School transport",
  "Safe drinking water",
];
---

<Layout
  title="Campus & Facilities — Bright Futures — Green Valley Matriculation School"
  description="Labs, classrooms, and the spaces students learn in at Green Valley Matriculation School."
>
  <section class="page-hero">
    <p class="eyebrow">Campus &amp; Facilities</p>
    <h1>The spaces students learn in.</h1>
    <p class="hero-lede">
      Modern facilities built for hands-on learning — labs, classrooms, and quiet places to read.
    </p>
  </section>

  <section class="content-wide facilities-layout">
    <div class="facility-image">
      <Image src={campusBuilding} alt="The school building seen across its front lawn" width={800} height={640} />
    </div>
    <div>
      <p class="eyebrow">On Campus</p>
      <h2>What's here.</h2>
      <ul class="fact-list">
        {facilities.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </section>

  <section class="content-wide mosaic">
    <figure><Image src={computerLab} alt="Rows of workstations in the school computer laboratory" width={700} height={520} /></figure>
    <figure><Image src={classroomBright} alt="A bright classroom with colourful desks ready for the day" width={700} height={520} /></figure>
    <figure><Image src={libraryStudy} alt="Students studying at long desks in the school library" width={700} height={520} /></figure>
  </section>
</Layout>

<style>
  .facilities-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; margin-bottom: 5rem; }
  .facility-image :global(img) { border-radius: 22px; width: 100%; aspect-ratio: 5/4; object-fit: cover; height: auto; }
  .mosaic { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .mosaic img { border-radius: 20px; width: 100%; aspect-ratio: 4/3; object-fit: cover; height: auto; }
  .mosaic figure { margin: 0; }

  @media (max-width: 1024px) {
    .facilities-layout { grid-template-columns: 1fr; }
    .facility-image { order: -1; }
  }
  @media (max-width: 720px) {
    .mosaic { grid-template-columns: 1fr; }
  }
</style>
