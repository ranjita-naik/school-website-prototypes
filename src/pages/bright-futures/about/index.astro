---
const base = import.meta.env.BASE_URL;
import Layout from "../../../layouts/BrightFuturesLayout.astro";
import { Image } from "astro:assets";
import assemblyMorning from "../../../assets/photos/shared/assembly-morning-01.jpg";
import campusBuilding from "../../../assets/photos/shared/campus-building-modern-01.jpg";
---

<Layout
  title="About the School — Bright Futures — Green Valley Matriculation School"
  description="Who Green Valley Matriculation School is, what it stands for, and a message from the Principal."
>
  <section class="page-hero">
    <p class="eyebrow">About the School</p>
    <h1>Built for students who ask "why," and "what's next."</h1>
    <p class="hero-lede">
      Green Valley Matriculation School is a Kindergarten–Class 10 school in Nagercoil, Tamil Nadu.
    </p>
  </section>

  <section class="content-wide">
    <div class="split">
      <div class="split-image">
        <Image src={assemblyMorning} alt="Students gathered in rows for morning assembly on the school ground" width={900} height={700} />
      </div>
      <div>
        <p class="eyebrow">Who We Are</p>
        <h2>Structured, but never stiff.</h2>
        <p>
          Green Valley was founded to give students a stronger academic foundation without
          losing the parts of school that make children want to show up: curiosity, friendship,
          and room to build things. <em>(Placeholder history — founding year and milestones to
          be confirmed with the school.)</em>
        </p>
        <p>
          <strong>Vision.</strong> Students who leave capable, confident, and ready for what's next.
          <br /><strong>Mission.</strong> Strong academics, modern methods, and a school that
          knows every student by name.
        </p>
      </div>
    </div>
  </section>

  <section class="content-section principal-section" id="principal">
    <p class="eyebrow">Leadership</p>
    <h2>A message from the Principal.</h2>
    <div class="principal-card">
      <blockquote>
        We hold high standards because we believe our students can meet them — and we back
        that belief with teachers who know exactly which student needs a push, and which
        needs patience.
      </blockquote>
      <p class="principal-attribution">— Mrs. Lakshmi Narayanan, Principal <em>(placeholder name)</em></p>
    </div>
  </section>

  <a class="immersive-band-alt reveal" href={base + "bright-futures/campus/"}>
    <Image src={campusBuilding} alt="The school building seen across its front lawn" width={1800} height={700} />
    <div class="scrim" aria-hidden="true"></div>
    <div class="caption">
      <h3>See the campus this runs on.</h3>
      <span class="doorway-arrow" aria-hidden="true" style="color:#fff;">Walk the campus →</span>
    </div>
  </a>
</Layout>

<style>
  .split { display: grid; grid-template-columns: 1fr 1.2fr; gap: 3rem; align-items: center; margin-bottom: 1rem; }
  .split-image :global(img) { border-radius: 22px; width: 100%; aspect-ratio: 4/3.2; object-fit: cover; height: auto; }

  .principal-card { background: #fff; border: 1px solid var(--line); border-radius: 22px; padding: 2.25rem; margin-top: 1.25rem; }
  .principal-card blockquote { font-size: 1.15rem; margin: 0 0 1em; color: var(--ink-900); font-weight: 500; }
  .principal-attribution { font-size: 0.85rem; color: var(--ink-soft); margin: 0; }

  .immersive-band-alt { position: relative; display: block; max-width: 1280px; margin: 5rem auto 0; border-radius: 22px; overflow: hidden; min-height: 280px; isolation: isolate; text-decoration: none; }
  .immersive-band-alt :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(16,24,43,0.75), transparent 60%); z-index: -1; }
  .caption { position: absolute; left: 0; right: 0; bottom: 0; padding: 2rem 2.5rem; color: #fff; }
  .caption h3 { color: #fff; margin: 0 0 0.3em; }

  @media (max-width: 1024px) {
    .split { grid-template-columns: 1fr; }
  }
</style>
