---
const base = import.meta.env.BASE_URL;
import Layout from "../../../layouts/BrightFuturesLayout.astro";

const steps = [
  { title: "Enquire", detail: "Submit an online enquiry form or call the admissions desk." },
  { title: "Visit", detail: "Tour the campus and meet the academic team." },
  { title: "Assess", detail: "A short, age-appropriate readiness conversation." },
  { title: "Confirm", detail: "Complete documentation and secure your child's seat." },
];

const documents = [
  "Birth certificate (original and copy)",
  "Transfer certificate, if applicable",
  "Previous year's report card, if applicable",
  "Address proof",
  "Passport-size photographs",
];

const faqs = [
  { q: "What ages does Green Valley accept?", a: "Kindergarten begins at age 3. Older classes accept transfers where seats are available." },
  { q: "Is there an entrance exam?", a: "No. Admission is based on a short readiness conversation, not a written test." },
  { q: "When does the academic year begin?", a: "Academic year and admission dates are placeholders pending confirmation from the school." },
];
---

<Layout
  title="Admissions — Bright Futures — Green Valley Matriculation School"
  description="How to enquire, visit, and apply to Green Valley Matriculation School — admissions process, documents, and FAQs."
>
  <section class="page-hero">
    <p class="eyebrow">Admissions</p>
    <h1>A clear, four-step path to joining Green Valley.</h1>
    <p class="hero-lede">
      No surprises, no long wait. Here's exactly what happens at each step.
    </p>
  </section>

  <section class="content-wide">
    <ol class="timeline">
      {steps.map((step, i) => (
        <li class="timeline-item">
          <span class="timeline-marker">{String(i + 1).padStart(2, "0")}</span>
          <h3>{step.title}</h3>
          <p>{step.detail}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="content-wide info-grid">
    <div class="info-card">
      <p class="eyebrow">Required Documents</p>
      <h2>What to bring.</h2>
      <ul class="fact-list">
        {documents.map((d) => <li>{d}</li>)}
      </ul>
    </div>
    <div class="info-card">
      <p class="eyebrow">Classes Offered</p>
      <h2>Kindergarten to Class 10.</h2>
      <ul class="fact-list">
        <li>Kindergarten — Ages 3–5</li>
        <li>Primary — Classes 1–5</li>
        <li>Middle School — Classes 6–8</li>
        <li>Secondary — Classes 9–10</li>
      </ul>
    </div>
  </section>

  <section class="content-section">
    <p class="eyebrow">Fees</p>
    <h2>A note on cost.</h2>
    <p>
      Fee details vary by class and are shared directly during your enquiry.
      <em>(Placeholder — actual fee structure to be confirmed with the school.)</em>
    </p>
  </section>

  <section class="content-section faq">
    <p class="eyebrow">Frequently Asked</p>
    <h2>A few common questions.</h2>
    <dl>
      {faqs.map((f) => (
        <>
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </>
      ))}
    </dl>
  </section>

  <section class="cta-band reveal">
    <h2>Questions before you visit?</h2>
    <p>The admissions office is glad to talk it through — by phone or email.</p>
    <a class="btn btn-primary btn-large" href={base + "bright-futures/contact/"}>Contact the Admissions Office</a>
  </section>
</Layout>

<style>
  .timeline { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; position: relative; }
  .timeline::before { content: ""; position: absolute; top: 22px; left: 5%; right: 5%; height: 2px; background: var(--line); }
  .timeline-item { position: relative; text-align: center; }
  .timeline-marker { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 10px; background: var(--cobalt-700); color: var(--sun-400); font-family: "Space Grotesk", sans-serif; font-weight: 700; margin-bottom: 1rem; position: relative; z-index: 1; }
  .timeline-item h3 { font-size: 1.05rem; margin-bottom: 0.3em; }
  .timeline-item p { font-size: 0.88rem; color: var(--ink-soft); margin: 0; }

  .faq dt { font-family: "Space Grotesk", sans-serif; font-weight: 700; margin-top: 1.25em; }
  .faq dd { margin: 0.3em 0 0; color: var(--ink-soft); }

  @media (max-width: 1024px) {
    .timeline { grid-template-columns: repeat(2, 1fr); row-gap: 2.5rem; }
    .timeline::before { display: none; }
  }
  @media (max-width: 720px) {
    .timeline { grid-template-columns: 1fr; }
  }
</style>
