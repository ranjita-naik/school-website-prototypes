---
import Layout from "../../../layouts/LearningGardenLayout.astro";
import { Image } from "astro:assets";
import assemblyPrayer from "../../../assets/photos/shared/assembly-prayer-01.jpg";
import classroomChildren from "../../../assets/photos/shared/classroom-children-tn-01.jpg";
import classroomChildrenTn2 from "../../../assets/photos/shared/classroom-children-tn-02.jpg";
import playgroundGround from "../../../assets/photos/shared/playground-ground-01.jpg";
import schoolGarden from "../../../assets/photos/shared/school-garden-01.jpg";
import computerLab from "../../../assets/photos/shared/computer-lab-01.jpg";
import campusEntrance from "../../../assets/photos/shared/campus-entrance-01.jpg";
import gardenPathway from "../../../assets/photos/shared/garden-pathway-01.jpg";
import forestPathway from "../../../assets/photos/shared/forest-pathway-01.jpg";

const photos = [
  { img: assemblyPrayer, alt: "Students standing together for morning assembly" },
  { img: gardenPathway, alt: "A lush, tree-lined garden path on campus" },
  { img: classroomChildren, alt: "Students focused at their desks in a classroom" },
  { img: playgroundGround, alt: "A green sports field used for play and games" },
  { img: schoolGarden, alt: "A green, well-tended school garden" },
  { img: computerLab, alt: "Students working at computers in the computer laboratory" },
  { img: campusEntrance, alt: "Tree-lined school entrance gate" },
  { img: classroomChildrenTn2, alt: "Students reading and writing at their desks" },
  { img: forestPathway, alt: "A quiet garden path on campus" },
];
---

<Layout
  title="Gallery — The Learning Garden — Green Valley Matriculation School"
  description="Photographs of campus life at Green Valley Matriculation School."
>
  <section class="page-hero">
    <p class="eyebrow">Gallery</p>
    <h1>A few moments from campus.</h1>
    <p class="hero-lede">
      Temporary photography, standing in for the school's own. <em>Every image here will be
      replaced with real, permission-cleared photography of Green Valley before launch.</em>
    </p>
  </section>

  <section class="content-wide">
    <ul class="gallery-grid">
      {photos.map((p) => (
        <li><Image src={p.img} alt={p.alt} width={640} height={480} /></li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 5rem;
  }
  .gallery-grid :global(img) {
    border-radius: 20px;
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .gallery-grid li:hover :global(img) { transform: scale(1.03); }

  @media (max-width: 1024px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .gallery-grid { grid-template-columns: 1fr; }
  }
</style>
