---
import Layout from "../../../layouts/LearningGardenLayout.astro";
import { Image } from "astro:assets";
import assemblyMorning from "../../../assets/photos/shared/assembly-morning-01.jpg";
import gardenPathway from "../../../assets/photos/shared/garden-pathway-01.jpg";
import studentsSecondary from "../../../assets/photos/shared/students-secondary-01.jpg";
import studentsPlay from "../../../assets/photos/shared/students-play-01.jpg";
import schoolGarden from "../../../assets/photos/shared/school-garden-01.jpg";
import forestPathway from "../../../assets/photos/shared/forest-pathway-01.jpg";

const photos = [
  { img: gardenPathway, alt: "A palm-lined garden path across the campus" },
  { img: assemblyMorning, alt: "Students gathered in rows for morning assembly on the school ground" },
  { img: forestPathway, alt: "A shaded path through dense greenery beside the campus" },
  { img: studentsSecondary, alt: "Secondary-school students together outside the classroom block" },
  { img: studentsPlay, alt: "Students playing together outdoors during break" },
  { img: schoolGarden, alt: "The school garden path lined with flowering shrubs" },
];
---

<Layout
  title="Gallery — The Learning Garden — Green Valley Matriculation School"
  description="Photographs of campus life at Green Valley Matriculation School."
>
  <section class="page-hero">
    <p class="eyebrow">Gallery</p>
    <h1>A few moments from campus.</h1>
    <p class="hero-lede">
      Temporary photography, standing in for the school's own. <em>Every image here will be
      replaced with real, permission-cleared photography of Green Valley before launch.</em>
    </p>
  </section>

  <section class="content-wide">
    <ul class="gallery-grid">
      {photos.map((p) => (
        <li><Image src={p.img} alt={p.alt} width={640} height={480} /></li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 5rem;
  }
  .gallery-grid :global(img) {
    border-radius: 20px;
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    transition: transform 0.3s ease; height: auto;
  }
  .gallery-grid li:hover :global(img) { transform: scale(1.03); }

  @media (max-width: 1024px) {
    .gallery-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 720px) {
    .gallery-grid { grid-template-columns: 1fr; }
  }
</style>
