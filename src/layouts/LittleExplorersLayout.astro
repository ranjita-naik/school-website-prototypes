---
const base = import.meta.env.BASE_URL;
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Nunito:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <p class="prototype-flag">Prototype concept 4 of 5 — "Little Explorers." Placeholder school, names, and content — not a real institution.</p>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
      <nav class="nav-pill" aria-label="Primary">
        <a class="brand" href={base + "little-explorers/"}>Green Valley</a>
        <ul class="nav-links">
          <li><a href={base + "little-explorers/#map"}>Explore</a></li>
          <li><a href={base + "little-explorers/admissions/"}>Admissions</a></li>
          <li><a href={base + "little-explorers/contact/"}>Contact</a></li>
        </ul>
        <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
        <label for="nav-toggle" class="nav-toggle" aria-label="Open menu"><span></span></label>
      </nav>
      <ul class="nav-links-mobile">
        <li><a href={base + "little-explorers/#map"}>Explore</a></li>
        <li><a href={base + "little-explorers/admissions/"}>Admissions</a></li>
        <li><a href={base + "little-explorers/contact/"}>Contact</a></li>
      </ul>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer" id="contact">
      <div class="footer-grid">
        <div class="footer-brand">
          <p class="footer-word">Green Valley Matriculation School</p>
          <p>Nagercoil, Tamil Nadu — 629001 <em>(placeholder address)</em></p>
          <p>+91 98765 43210 · info@greenvalley.example <em>(placeholder)</em></p>
        </div>
        <nav class="footer-col" aria-label="Explore">
          <h3>Explore</h3>
          <ul>
            <li><a href={base + "little-explorers/about/"}>About the School</a></li>
            <li><a href={base + "little-explorers/academics/"}>Academics</a></li>
            <li><a href={base + "little-explorers/admissions/"}>Admissions</a></li>
            <li><a href={base + "little-explorers/campus/"}>Campus &amp; Facilities</a></li>
            <li><a href={base + "little-explorers/gallery/"}>Gallery</a></li>
          </ul>
        </nav>
        <nav class="footer-col" aria-label="For Parents">
          <h3>For Parents</h3>
          <ul>
            <li><a href={base + "little-explorers/parents/"}>Parent Resources</a></li>
            <li><a href={base + "little-explorers/events/"}>Events &amp; Announcements</a></li>
            <li><a href={base + "little-explorers/faculty/"}>Faculty &amp; Leadership</a></li>
            <li><a href={base + "little-explorers/policies/"}>Policies &amp; Disclosures</a></li>
          </ul>
        </nav>
        <div class="footer-col">
          <h3>Office Hours</h3>
          <p>Monday–Saturday<br />8:30 AM – 3:30 PM</p>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2026 Green Valley Matriculation School. Placeholder content for design prototype purposes only.</p>
      </div>
    </footer>

    <style is:global>
      body {
        --turquoise-500: #1f9e98;
        --orange-500: #e97a34;
        --berry-600: #a8305a;
        --yellow-400: #eeba3f;
        --lavender-300: #b39ddb;
        --white-warm: #fffcf7;
        --ink-800: #2a2438;
        --ink-soft: #5c5468;
        --line: #ece4f2;

        margin: 0;
        font-family: "Nunito", sans-serif;
        color: var(--ink-800);
        background: var(--white-warm);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      h1, h2, h3 { font-family: "Baloo 2", sans-serif; font-weight: 700; line-height: 1.2; margin: 0 0 0.5em; }
      p { margin: 0 0 1em; }
      ul, ol { list-style: none; margin: 0; padding: 0; }
      img { max-width: 100%; display: block; }
      a { color: inherit; }
      :focus-visible { outline: 3px solid var(--berry-600); outline-offset: 3px; }

      .prototype-flag { margin: 0; text-align: center; font-size: 0.78rem; background: var(--ink-800); color: #fff; padding: 0.4em 1em; }
      .skip-link { position: absolute; left: -999px; top: 0; background: var(--ink-800); color: #fff; padding: 0.75em 1.25em; z-index: 100; }
      .skip-link:focus { left: 0; }

      .eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.78rem; font-weight: 800; color: var(--berry-600); margin: 0 0 0.5em; }
      .eyebrow.center { text-align: center; }

      .btn { display: inline-block; padding: 0.85em 1.7em; border-radius: 14px; font-weight: 700; text-decoration: none; border: 2px solid transparent; transition: transform 0.15s ease; }
      .btn:hover { transform: translateY(-2px); }
      .btn-primary { background: var(--berry-600); color: #fff; box-shadow: 0 10px 22px -10px rgba(194,59,107,0.55); }
      .btn-ghost { background: #fff; border-color: var(--turquoise-500); color: var(--turquoise-500); }
      .btn-large { padding: 1em 2.2em; font-size: 1.05rem; }

      .text-link { display: inline-block; margin-top: 0.5em; font-weight: 700; color: var(--berry-600); text-decoration: none; }
      .text-link:hover { text-decoration: underline; }

      /* Header */
      .site-header { position: sticky; top: 0; z-index: 50; padding: 1rem 1.5rem 0; }
      .nav-pill {
        max-width: 900px; margin: 0 auto;
        background: #fff; border-radius: 22px;
        display: flex; align-items: center; gap: 1.5rem;
        padding: 0.6rem 0.6rem 0.6rem 1.4rem;
        box-shadow: 0 12px 30px -14px rgba(42,36,56,0.25);
      }
      .brand { display: flex; align-items: center; gap: 0.5rem; font-family: "Baloo 2", sans-serif; font-weight: 700; text-decoration: none; color: var(--ink-800); margin-right: auto; }
      .nav-links { display: flex; gap: 1.5rem; font-weight: 700; font-size: 0.9rem; }
      .nav-links a { text-decoration: none; padding: 0.6em 0.9em; border-radius: 12px; transition: background 0.15s ease; }
      .nav-links a:hover { background: var(--line); }
      .nav-toggle-input { display: none; }
      .nav-toggle { display: none; cursor: pointer; padding: 0.6rem; border-radius: 12px; background: var(--line); }
      .nav-toggle span, .nav-toggle span::before, .nav-toggle span::after { content: ""; display: block; width: 20px; height: 2px; background: var(--ink-800); position: relative; }
      .nav-toggle span::before { position: absolute; top: -6px; }
      .nav-toggle span::after { position: absolute; top: 6px; }
      .nav-links-mobile { display: none; }

      /* Page header (inner pages) */
      .page-hero { max-width: 900px; margin: 0 auto; padding: 3.5rem 1.5rem 2.5rem; text-align: center; }
      .page-hero h1 { font-size: clamp(2rem, 4vw, 2.8rem); }
      .page-hero .hero-lede { font-size: 1.08rem; max-width: 55ch; margin: 0 auto; color: var(--ink-soft); }

      /* Doorway-style cards for inner-page cross-links */
      .doorways { max-width: 1100px; margin: 0 auto 5rem; padding: 0 1.5rem; }
      .doorway-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
      .doorway-card { background: #fff; border-radius: 20px; overflow: hidden; box-shadow: 0 12px 28px -16px rgba(42,36,56,0.25); transition: transform 0.2s ease; }
      .doorway-card:hover { transform: translateY(-4px); }
      .doorway-card a { display: block; text-decoration: none; color: inherit; }
      .doorway-image { aspect-ratio: 4/3; }
      .doorway-image img { width: 100%; height: 100%; object-fit: cover; }
      .doorway-card h3 { font-size: 1.1rem; margin: 1.25rem 1.5rem 0.3em; }
      .doorway-card p { font-size: 0.9rem; color: var(--ink-soft); margin: 0 1.5rem 1.25rem; }

      /* Simple content blocks reused on inner pages */
      .content-section { max-width: 760px; margin: 4rem auto; padding: 0 1.5rem; }
      .content-section h2 { font-size: clamp(1.5rem, 2.6vw, 2rem); }
      .content-section p { color: var(--ink-soft); }
      .content-wide { max-width: 1100px; margin: 4rem auto; padding: 0 1.5rem; }

      .fact-list { display: grid; gap: 0.6em; margin: 1.25em 0; }
      .fact-list li { font-size: 0.96rem; color: var(--ink-soft); padding-left: 1.4em; position: relative; }
      .fact-list li::before { content: ""; position: absolute; left: 0; top: 0.5em; width: 7px; height: 7px; border-radius: 50%; background: var(--turquoise-500); }

      .info-card { background: #fff; border-radius: 20px; padding: 2rem; box-shadow: 0 12px 28px -16px rgba(42,36,56,0.2); }
      .info-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }

      table.simple-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
      table.simple-table caption { text-align: left; font-weight: 700; margin-bottom: 0.75em; }
      table.simple-table th, table.simple-table td { text-align: left; padding: 0.85em 1em; border-bottom: 1px solid var(--line); }
      table.simple-table th { font-family: "Baloo 2", sans-serif; color: var(--ink-800); }
      table.simple-table td { color: var(--ink-soft); }
      .table-scroll { overflow-x: auto; }

      /* CTA band */
      .cta-band { max-width: 700px; margin: 0 auto 5rem; padding: 0 1.5rem; text-align: center; }
      .cta-band h2 { font-size: clamp(1.6rem, 2.8vw, 2.1rem); }
      .cta-band p { color: var(--ink-soft); }

      /* Footer */
      .site-footer { background: #fff; border-top: 1px solid var(--line); padding: 4rem 1.5rem 1.5rem; }
      .footer-grid { max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 2.5rem; }
      .footer-word { font-family: "Baloo 2", sans-serif; font-weight: 700; margin-bottom: 0.5em; }
      .footer-brand p { font-size: 0.88rem; color: var(--ink-soft); }
      .footer-col h3 { font-family: "Nunito", sans-serif; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1em; color: var(--berry-600); }
      .footer-col ul { display: grid; gap: 0.6em; }
      .footer-col a { text-decoration: none; font-size: 0.88rem; color: var(--ink-soft); }
      .footer-col a:hover { color: var(--berry-600); }
      .footer-bottom { max-width: 1240px; margin: 3rem auto 0; padding-top: 1.5rem; border-top: 1px solid var(--line); font-size: 0.78rem; color: var(--ink-soft); }

      @media (prefers-reduced-motion: reduce) {
        .btn:hover, .map-stop:hover .stop-bubble { transform: none; }
      }

      @media (max-width: 1024px) {
        .doorway-grid { grid-template-columns: repeat(2, 1fr); }
        .info-grid { grid-template-columns: 1fr; }
      }

      @media (max-width: 780px) {
        .nav-links, .nav-cta { display: none; }
        .nav-toggle { display: block; }
        .nav-links-mobile {
          display: block;
          max-width: 900px; margin: 0.5rem auto 0;
          background: #fff; border-radius: 20px;
          box-shadow: 0 12px 30px -14px rgba(42,36,56,0.25);
          max-height: 0; overflow: hidden; transition: max-height 0.25s ease;
        }
        .nav-toggle-input:checked ~ .nav-links-mobile { max-height: 300px; }
        .nav-links-mobile li { border-top: 1px solid var(--line); }
        .nav-links-mobile a { display: block; padding: 1em 1.5rem; text-decoration: none; font-weight: 700; }
        .doorway-grid { grid-template-columns: 1fr; }
        .footer-grid { grid-template-columns: 1fr; gap: 2rem; }
      }
    </style>

    <script>
      const navToggle = document.getElementById("nav-toggle");
      document.querySelectorAll(".nav-links-mobile a").forEach((link) => {
        link.addEventListener("click", () => {
          if (navToggle instanceof HTMLInputElement) navToggle.checked = false;
        });
      });
    </script>
  </body>
</html>
